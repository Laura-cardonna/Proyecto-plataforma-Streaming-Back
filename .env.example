# Copia este archivo como ".env" y rellena tus propios valores.

# Puerto donde corre el backend
PORT=5000

# Cadena de conexión a MongoDB.
# Opción A - MongoDB local:
MONGO_URI=mongodb://localhost:27017/StreamingProject

# Opción B - MongoDB Atlas (nube): reemplaza usuario, clave y cluster por los tuyos
# MONGO_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/StreamingProject?retryWrites=true&w=majority
